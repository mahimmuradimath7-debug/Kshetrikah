# =================================================================
# KSHETRIKAH (क्षेत्रिकः) - AI VISION & ENVIRONMENTAL CONFIGURATION
# Developed by TEAM BITHEADS for Government of Maharashtra (MSInS #26131)
# =================================================================

# Google Gemini Vision API Key (Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# (Optional) Comma-separated Gemini keys for auto-failover and load balancing
# GEMINI_API_KEYS=key1,key2,key3

# NVIDIA NIM Enterprise Vision Microservice
# Endpoint: https://integrate.api.nvidia.com/v1
# Keys from: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# (Optional) Anthropic Claude API Key fallback
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (PostgreSQL cloud database)
# Project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
